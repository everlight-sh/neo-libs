import "std:strings"
import "std:vec"

; RFC 6716 section 3 framing only. This does not encode/decode PCM, SILK or
; CELT, perform PLC/FEC, or claim that compressed frame contents are valid.
type OpusFrame = { offset:i64,length:i64 }
type OpusPacket = { ok:bool,config:i64,stereo:bool,frames:Arr OpusFrame _,samples_48k:i64 }
type OpusSize = { ok:bool,size:i64,following:i64 }
private fn opus_size(bytes:Arr u8 n,at:i64,end:i64) -> OpusSize
  = if at<0 || at>=end || end>n then OpusSize { ok=false,size=0,following=at } else
    let first=str_byte(bytes,at) in if first<252 then OpusSize { ok=true,size=first,following=at+1 } else
    if at+1>=end then OpusSize { ok=false,size=0,following=at } else OpusSize { ok=true,size=first+str_byte(bytes,at+1)*4,following=at+2 }
private fn opus_samples(toc:i64) -> i64
  = if bit_and(toc,128)!=0 then shift_left(120,bit_and(shift_right(toc,3),3)) else
    if bit_and(toc,96)==96 then shift_left(480,bit_and(shift_right(toc,3),1)) else
    let mode=bit_and(shift_right(toc,3),3) in if mode==3 then 2880 else shift_left(480,mode)
private fn opus_invalid() -> OpusPacket = OpusPacket { ok=false,config=0,stereo=false,frames=arr(i in 0..0) OpusFrame { offset=0,length=0 },samples_48k=0 }
fn opus_packet(bytes:Arr u8 n) -> OpusPacket
  = let invalid=opus_invalid() in if n<1 || n>65535 then invalid else
    let toc=str_byte(bytes,0) in let code=bit_and(toc,3) in let samples=opus_samples(toc) in
    let count=if code==0 then 1 else if code==1 || code==2 then 2 else if n>=2 then bit_and(str_byte(bytes,1),63) else 0 in
    if count<1 || count>48 || samples*count>5760 then invalid else
    let padded=code==3 && bit_and(str_byte(bytes,1),64)!=0 in
    let padding=loop(at=2,padding=0,more=padded) while more && at<n && padding<=n next(at+1,
      let value=str_byte(bytes,at) in padding+(if value==255 then 254 else value),str_byte(bytes,at)==255) yield
      OpusSize { ok= !more && padding<=n,size=padding,following=if padded then at else if code==3 then 2 else 1 } in
    if !padding.ok || padding.following>n-padding.size then invalid else
    let end=n-padding.size in let vbr=code==2 || code==3 && bit_and(str_byte(bytes,1),128)!=0 in
    let lengths=if !vbr then
      let remaining=end-padding.following in if remaining%count!=0 || remaining/count>1275 then vec_empty::<OpusFrame>() else
      loop(i=0,out=vec_empty::<OpusFrame>()) while i<count next(i+1,vec_push(out,OpusFrame { offset=padding.following+i*(remaining/count),length=remaining/count })) yield out else
      loop(i=0,at=padding.following,total=0,sizes=vec_empty::<i64>(),valid=true) while valid && i<count-1 next(i+1,
        opus_size(bytes,at,end).following,total+opus_size(bytes,at,end).size,vec_push(sizes,opus_size(bytes,at,end).size),
        let size=opus_size(bytes,at,end) in size.ok && size.size<=1275 && total+size.size<=end-size.following) yield
        if !valid || end-at-total<0 || end-at-total>1275 then vec_empty::<OpusFrame>() else
        loop(j=0,offset=at,out=vec_empty::<OpusFrame>()) while j<count next(j+1,
          offset+(if j==count-1 then end-at-total else match vec_get(sizes,j) { None => 0,Some(size) => size }),
          vec_push(out,OpusFrame { offset=offset,length=if j==count-1 then end-at-total else match vec_get(sizes,j) { None => 0,Some(size) => size } })) yield out in
    if vec_len(lengths)!=count then invalid else
    check count>=0 in OpusPacket { ok=true,config=shift_right(toc,3),stereo=bit_and(toc,4)!=0,
      frames=arr(i in 0..count) match vec_get(lengths,i) { None => OpusFrame { offset=0,length=0 },Some(frame) => frame },samples_48k=samples*count }
